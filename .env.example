# Copy this file to .env and fill in your key.
# Get an API key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional settings
# PORT=3000
# HOST=127.0.0.1                  # use 0.0.0.0 to open the app to other devices on your network
# MOTION_STUDIO_MODEL=claude-opus-5-5
# MOTION_STUDIO_EFFORT=medium      # low | medium | high | xhigh | max (higher = more polished but slower)
# MOTION_STUDIO_FALLBACKS=off      # turn off automatic retry on a fallback model when a request is declined
